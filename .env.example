NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME=

# Google Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# -------------------------------------------------------------------------
# SMTP – E-posta gönderimi (fatura ve sipariş onayı için)
# Tüm SMTP sağlayıcılarıyla (Gmail, Resend, Mailgun vb.) uyumludur.
# Yapılandırılmazsa e-posta gönderimi atlanır; sipariş yine de oluşturulur.
# -------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_SECURE=true için SSL/TLS kullanılır (port 465). false için STARTTLS.
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
# Gönderici adresi (isteğe bağlı, varsayılan: noreply@dentalisveris.com)
SMTP_FROM="Dent Alışveriş <noreply@dentalisveris.com>"
